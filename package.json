{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-engram",
  "version": "0.1.1",
  "description": "Long-term project memory, evals, telemetry, and archive workflows for OpenCode.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmazac/opencode-engram.git"
  },
  "homepage": "https://github.com/jackmazac/opencode-engram#readme",
  "bugs": {
    "url": "https://github.com/jackmazac/opencode-engram/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "agent-memory",
    "retrieval",
    "sqlite",
    "eval"
  ],
  "scripts": {
    "prepack": "node ./scripts/npm-prepack-strip-overrides.mjs",
    "postpack": "node ./scripts/npm-postpack-restore-package-json.mjs",
    "build": "tsgo --noEmit",
    "check": "bun run lint:no-zod && bun run typecheck && bun test --timeout 30000",
    "doctor": "bun src/cli/run.ts doctor --json",
    "lint:no-zod": "bun run ./node_modules/@mazac-fox/opencode-host-adapter/src/cli/check-no-zod-import.ts src/",
    "smoke:runtime": "bun scripts/runtime-smoke.ts",
    "sprint": "bun run ./src/cli/run.ts sprint --local-only --rows 3000 --worktree .",
    "status": "bun src/cli/run.ts status --json",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 30000"
  },
  "bin": {
    "engram": "./src/cli/run.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/run.ts",
    "./bridge": "./src/bridge-contract.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "eval/fixtures",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "@mazac-fox/opencode-fleet-contracts": "file:../opencode-fleet-contracts",
    "@mazac-fox/opencode-host-adapter": "file:../opencode-host-adapter"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.89",
    "@mazac-fox/opencode-fleet-contracts": "^0.1.0",
    "@mazac-fox/opencode-host-adapter": "^0.1.0",
    "@opencode-ai/plugin": "1.14.31",
    "@opencode-ai/sdk": "1.3.3",
    "ai": "5.0.124",
    "strip-json-comments": "5.0.1",
    "ulid": "3.0.1",
    "xdg-basedir": "5.1.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.11",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  }
}
